# Copy the values you need into `.env.local` for development, and into
# Vercel -> Project Settings -> Environment Variables for production.
#
# `.env*` is gitignored, so nothing in a real env file is ever committed.

# --- Office geofence -------------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the JavaScript at BUILD time. Editing
# them requires `npm run dev` to pick them up automatically, or a fresh
# `npm run build` before `npm start` / a redeploy.
NEXT_PUBLIC_OFFICE_NAME="name of your office"
NEXT_PUBLIC_OFFICE_LAT=-"latitude of your office"
NEXT_PUBLIC_OFFICE_LNG="longitude of your office"
NEXT_PUBLIC_OFFICE_RADIUS="radius in meters of your office geofence"

# --- Admin login -----------------------------------------------------------
# Password for /admin. Leave unset to disable sign-in entirely.
ADMIN_PASSWORD=

# Signs the session cookie. Any long random string; without it login returns
# 500 and every admin session is rejected.
SESSION_SECRET=

# --- Postgres --------------------------------------------------------------
# Use the POOLED connection string. For hosted providers keep `sslmode=require`
# in the URL (or omit it - TLS is enabled automatically for non-local hosts).
# Unset means storage falls back to memory and the recap shows a warning.
DATABASE_URL=
